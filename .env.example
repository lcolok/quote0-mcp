# quote0-mcp Environment Variables
# Copy this file to .env and fill in your actual values

# =============================================================================
# Application Server
# =============================================================================
PORT=3001
HOST=0.0.0.0
NODE_ENV=development

# =============================================================================
# PostgreSQL Database
# =============================================================================
POSTGRES_HOST=localhost
POSTGRES_PORT=25432
POSTGRES_DB=quote0_cache
POSTGRES_USER=quote0_user
POSTGRES_PASSWORD=quote0_password
# Or use a single connection string (takes precedence if set)
# DATABASE_URL=postgresql://quote0_user:quote0_password@localhost:25432/quote0_cache

# =============================================================================
# Redis Cache
# =============================================================================
REDIS_HOST=localhost
REDIS_PORT=26379
# Or use a single connection string (takes precedence if set)
# REDIS_URL=redis://localhost:26379

# =============================================================================
# MinIO Object Storage
# =============================================================================
MINIO_ENDPOINT=localhost
MINIO_PORT=29000
MINIO_ACCESS_KEY=quote0_minio
MINIO_SECRET_KEY=quote0_minio_password
MINIO_BUCKET=quote0-images
MINIO_USE_SSL=false

# =============================================================================
# LLM Configuration
# =============================================================================
LLM_BASE_URL=https://token-plan-cn.xiaomimimo.com/v1
LLM_API_KEY=your_llm_api_key_here
LLM_MODEL=mimo-v2.5-pro

# =============================================================================
# MindReset Device (for e-ink cloud push)
# =============================================================================
MINDRESET_DEVICE_ID=your_device_serial_number_here
MINDRESET_DEVICE_SECRET=your_device_secret_here
MINDRESET_BASE_URL=https://dot.mindreset.tech/api

# =============================================================================
# Optional: Niimbot Label Printer
# =============================================================================
# NIIMBOT_ENDPOINT=http://localhost:9100

# =============================================================================
# Optional: BizyAir / Copilot
# =============================================================================
# COPILOT_BIZYAIR_BASE_URL=https://copilot.logic.heiyu.space/providers/bizyair/v1
