# MindReset MCP Server Environment Variables
# Copy this file to .env and fill in your actual values

# Required: Your MindReset device serial number
# Get this from the MindReset App
MINDRESET_DEVICE_ID=your_device_serial_number_here

# Required: Your MindReset device secret/API key
# Get this from the MindReset App
MINDRESET_DEVICE_SECRET=your_device_secret_here

# Optional: Base URL for MindReset API (default: https://dot.mindreset.tech/api)
# MINDRESET_BASE_URL=https://dot.mindreset.tech/api