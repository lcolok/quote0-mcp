FROM node:22-slim

USER root

# 只安装 Satori 必要的最小依赖
RUN apt-get update && apt-get install -y \
    ca-certificates \
    curl \
    --no-install-recommends \
    && update-ca-certificates \
    && curl -fsSL https://bun.sh/install | bash \
    && apt-get autoremove -y \
    && rm -rf /var/lib/apt/lists/*

ENV PATH="/root/.bun/bin:${PATH}"

WORKDIR /app