# 多阶段构建 - 构建阶段
FROM dev.logic.heiyu.space/library/bun:alpine AS builder

WORKDIR /app

# 复制依赖清单和锁文件，确保盒子端构建与本地 E2E 使用同一组依赖。
COPY package.json bun.lock ./

# 安装依赖（用淘宝镜像，LC03 无法访问 registry.npmjs.org）。
# frozen-lockfile 防止生产镜像在构建时悄悄解析到更新版本。
RUN bun install --frozen-lockfile --registry=https://registry.npmmirror.com/

# 复制源代码
COPY . .

# 构建生产版本
RUN bun run build

# 生产阶段 - 使用nginx服务静态文件
FROM dev.logic.heiyu.space/library/nginx:alpine

# 复制构建产物
COPY --from=builder /app/dist /usr/share/nginx/html

# 复制懒猫微服专用nginx配置（API代理指向懒猫内网服务名）
COPY nginx.lazycat.conf /etc/nginx/conf.d/default.conf

# 覆盖默认健康检查以避免IPv6回环问题
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD wget --quiet --tries=1 --spider http://127.0.0.1/ || exit 1

# 暴露端口
EXPOSE 80

# 启动nginx
CMD ["nginx", "-g", "daemon off;"]
