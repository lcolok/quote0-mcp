{
  "name": "mindreset-mcp-server",
  "version": "1.0.0",
  "type": "module",
  "description": "MCP server for MindReset devices providing text and image API tools",
  "main": "dist/index.js",
  "bin": {
    "mindreset-mcp": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "build:image-sender": "mkdir -p dist/image-sender/interfaces/cli && cp -r src/image-sender/* dist/image-sender/ 2>/dev/null || echo 'image-sender files copied'",
    "build:ax-framework": "tsc -p ax-framework/tsconfig.json",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "test": "echo \"Error: no test specified\" && exit 1",
    "image:send": "node dist/image-sender/interfaces/cli/cli-main.js send",
    "image:preview": "node dist/image-sender/interfaces/cli/cli-main.js preview",
    "image:mono": "node dist/image-sender/interfaces/cli/cli-main.js mono",
    "image:quick": "tsx src/image-sender/cli/quick-send.ts",
    "image:ordered": "tsx src/image-sender/processors/ordered-dither.ts",
    "image:enhanced-ordered": "tsx src/image-sender/processors/enhanced-ordered.ts",
    "widget": "tsx src/react-widgets/cli/universal-cli.ts",
    "widget:weather": "tsx src/react-widgets/cli/weather-cli.ts",
    "widget:weather-new": "tsx src/react-widgets/cli/weather-cli-new.ts",
    "widget:news": "tsx src/react-widgets/cli/news-cli.ts",
    "widget:modular-news": "bunx tsx src/react-widgets/cli/modular-news-cli.ts",
    "widget:preview": "tsx src/react-widgets/examples/weather-example.tsx",
    "widget:compare": "tsx scripts/compare-widgets.ts",
    "widget:test": "tsx src/react-widgets/tests/weather-services.test.ts",
    "widget:test-api": "tsx src/react-widgets/tests/api-integration.test.ts",
    "widget:test-city": "tsx src/react-widgets/tools/city-service-test.ts",
    "widget:test-amap": "tsx src/react-widgets/tests/amap-weather.test.ts",
    "widget:test-multi": "tsx src/react-widgets/tests/multi-source.test.ts",
    "widget:diagnostics": "tsx src/react-widgets/tools/network-diagnostics.ts",
    "widget:monitor": "tsx src/react-widgets/tools/api-monitor.ts",
    "icons:test": "tsx scripts/test-icons.ts",
    "setup": "bunx tsx scripts/setup-services.ts",
    "check": "bunx tsx scripts/check-services.ts",
    "status": "docker ps --format 'table {{.Names}}\\t{{.Status}}\\t{{.Ports}}' --filter name=quote0"
  },
  "keywords": [
    "mcp",
    "mindreset",
    "model-context-protocol",
    "ai",
    "server"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@ax-llm/ax": "^14.0.16",
    "@modelcontextprotocol/sdk": "^1.17.2",
    "@types/pg": "^8.15.5",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@types/redis": "^4.0.11",
    "@types/sqlite3": "^5.1.0",
    "canvas": "^3.2.0",
    "epdoptimize": "^0.1.3",
    "minio": "^8.0.5",
    "openai": "^5.15.0",
    "pg": "^8.16.3",
    "puppeteer": "^24.17.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-icons": "^5.5.0",
    "redis": "^5.8.2",
    "rss-parser": "^3.13.0",
    "sqlite": "^5.1.1",
    "sqlite3": "^5.1.7",
    "undici": "^6.19.8",
    "weathercityid": "^0.0.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^24.2.1",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  },
  "engines": {
    "node": ">=18"
  }
}
