# 懒猫微服版 Dockerfile
# 使用 node 基础镜像 + 安装 Chromium，支持 ARM64

FROM node:18-bullseye-slim as base-runtime

USER root

# 安装必要工具、Bun 和 Chromium
RUN apt-get update && apt-get install -y \
    unzip \
    curl \
    wget \
    gnupg \
    ca-certificates \
    chromium \
    fonts-liberation \
    libappindicator3-1 \
    libasound2 \
    libatk-bridge2.0-0 \
    libatk1.0-0 \
    libc6 \
    libcairo2 \
    libcups2 \
    libdbus-1-3 \
    libexpat1 \
    libfontconfig1 \
    libgbm1 \
    libgcc1 \
    libglib2.0-0 \
    libgtk-3-0 \
    libnspr4 \
    libnss3 \
    libpango-1.0-0 \
    libpangocairo-1.0-0 \
    libstdc++6 \
    libx11-6 \
    libx11-xcb1 \
    libxcb1 \
    libxcomposite1 \
    libxcursor1 \
    libxdamage1 \
    libxext6 \
    libxfixes3 \
    libxi6 \
    libxrandr2 \
    libxrender1 \
    libxss1 \
    libxtst6 \
    lsb-release \
    xdg-utils \
    build-essential \
    pkg-config \
    python3 \
    libcairo2-dev \
    libjpeg-dev \
    libpango1.0-dev \
    libgif-dev \
    librsvg2-dev \
    libpixman-1-dev \
    && curl -fsSL https://bun.sh/install | bash \
    && ln -s /root/.bun/bin/bun /usr/local/bin/bun \
    && ln -s /root/.bun/bin/bunx /usr/local/bin/bunx \
    && rm -rf /var/lib/apt/lists/*

# Puppeteer 配置（使用系统 Chromium）
ENV PUPPETEER_SKIP_CHROMIUM_DOWNLOAD=true
ENV PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium

WORKDIR /app

# 阶段2: 依赖安装
FROM base-runtime as dependencies

COPY package.json bun.lock ./
COPY assets/ ./assets/
COPY config/ ./config/

RUN bun install --frozen-lockfile

# 阶段3: 应用构建
FROM dependencies as app-build

ARG BUILD_REVISION=0
RUN echo "Build revision: ${BUILD_REVISION}"

COPY ax-framework/ ./ax-framework/
COPY docker/ ./docker/
COPY scripts/ ./scripts/

ENV TZ=Asia/Shanghai
RUN ln -snf /usr/share/zoneinfo/$TZ /etc/localtime && echo $TZ > /etc/timezone

COPY src/ ./src/

RUN mkdir -p processed-images/widgets/news

# 阶段4: 生产运行
FROM app-build as production

ENV NODE_ENV=production
ENV PORT=3001

EXPOSE 3001

HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:3001/api/health || exit 1

CMD ["bun", "src/api/server.ts"]
