# 模块化新闻API - 多阶段构建优化版本
# 分离基础环境和应用代码，提升构建效率

# ===================== 阶段1: 基础环境构建 =====================
FROM dev.logic.heiyu.space/library/node:22-slim-bun as base-runtime

WORKDIR /app

# TRMNL Framework fidelity renderer uses the same browser-backed path as the
# existing Puppeteer renderer. Make Chromium an explicit image capability
# instead of relying on the stale manifest path alone.
RUN apt-get update \
    && apt-get install -y --no-install-recommends chromium fonts-liberation \
    && rm -rf /var/lib/apt/lists/*
ENV PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium
ENV PUPPETEER_SKIP_DOWNLOAD=true

# ===================== 阶段2: 依赖安装 =====================
FROM base-runtime as dependencies

# 只复制依赖相关文件 (package.json变化频率较低)
COPY package.json bun.lock ./

# 复制静态资源 (变化频率较低)
COPY assets/ ./assets/
COPY config/ ./config/

# 安装依赖 (只有依赖变化时才会重新执行)。
# LC03 对 registry.npmjs.org 偶有长尾；与 annotation-web 一样固定镜像源，
# 同时保留 frozen lockfile，确保远端镜像与本地验证使用完全相同的依赖图。
RUN bun install --frozen-lockfile --registry=https://registry.npmmirror.com/

# ===================== 阶段3: 应用构建 =====================  
FROM dependencies as app-build

# build cache bust argument (set from deploy tooling)
ARG BUILD_REVISION=0
RUN echo "Build revision: ${BUILD_REVISION}"

# 复制框架相关文件 (变化频率中等)
COPY ax-framework/ ./ax-framework/
COPY docker/ ./docker/
COPY scripts/ ./scripts/
# Embed the release envelope that this news-api image was built from. Runtime
# health/version endpoints read this copy, so a pinned old image keeps its true
# component identity when a later app release only rebuilds another service.
COPY lazycat/lzc-manifest.yml ./lazycat/lzc-manifest.yml

# 设置时区
ENV TZ=Asia/Shanghai
RUN ln -snf /usr/share/zoneinfo/$TZ /etc/localtime && echo $TZ > /etc/timezone

# 复制源代码 (变化频率最高，放在最后)
COPY src/ ./src/

# 创建必要的目录
RUN mkdir -p processed-images/widgets/news

# ===================== 阶段4: 开发模式 (可选) =====================
FROM app-build as development

ENV NODE_ENV=development
ENV PORT=3001

# 开发模式使用热重载
CMD ["bun", "--watch", "src/api/server.ts"]

# ===================== 阶段5: 生产运行 =====================
FROM app-build as production

# 设置环境变量
ENV NODE_ENV=production
ENV PORT=3001

# 暴露端口
EXPOSE 3001

# 健康检查
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:3001/api/health || exit 1

# 启动命令
CMD ["bun", "src/api/server.ts"]
