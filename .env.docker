# Quote0 MCP 容器化缓存系统环境变量

# PostgreSQL 数据库配置
DATABASE_URL=postgresql://quote0_user:quote0_password@localhost:5432/quote0_cache
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=quote0_cache
POSTGRES_USER=quote0_user
POSTGRES_PASSWORD=quote0_password

# MinIO 对象存储配置
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=quote0_minio
MINIO_SECRET_KEY=quote0_minio_password
MINIO_BUCKET=quote0-images
MINIO_USE_SSL=false

# Redis 缓存配置
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379

# 缓存配置
CACHE_DATA_TTL=1800000      # 数据缓存TTL: 30分钟
CACHE_IMAGE_TTL=86400000    # 图片缓存TTL: 24小时  
CACHE_RSS_TTL=600000        # RSS快照TTL: 10分钟
ENABLE_STAGED_CACHE=true    # 启用分阶段缓存

# LLM 服务配置 (原有配置保持不变)
LLM_PROVIDER=custom
LLM_BASE_URL=https://copilot.logic.heiyu.space/v1
LLM_API_KEY=your_api_key_here
LLM_MODEL=gpt-5-mini
LLM_FAST_MODEL=gpt-4o
LLM_MAX_TOKENS=1000
LLM_TEMPERATURE=0.7

# MindReset 设备配置 (原有配置保持不变)  
MINDRESET_DEVICE_ID=E4B063CC0F10
MINDRESET_DEVICE_SECRET=dot_app_pVMhvUteeDqAnibZQtMofYnkJuyaMjEXzgcohArxPyJbEJgnYPTpUcRsalPnEDyr

# 应用配置
NODE_ENV=development
PORT=3000

# 日志配置
LOG_LEVEL=info
LOG_FORMAT=json