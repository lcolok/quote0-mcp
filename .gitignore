# Dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Build output
dist/
build/

# AX Framework编译产物（由训练数据源码自动生成）
ax-framework/compiled/

# 其他TypeScript编译产物
*.js.map
*.d.ts.map
# 排除scripts目录中的TS编译产物（保留源码.ts文件）  
scripts/*.js
scripts/*.d.ts
scripts/*.js.map
scripts/*.d.ts.map

# Environment variables
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# E-Ink device config (contains tokens)
config/eink-devices.json

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# Coverage directory used by tools like istanbul
coverage/
*.lcov

# nyc test coverage
.nyc_output

# Dependency directories
jspm_packages/

# Optional npm cache directory
.npm

# Optional eslint cache
.eslintcache

# Optional REPL history
.node_repl_history

# Output of 'npm pack'
*.tgz

# Yarn Integrity file
.yarn-integrity

# dotenv environment variables file
.env.test

# parcel-bundler cache (https://parceljs.org/)
.cache
.parcel-cache

# next.js build output
.next

# nuxt.js build output
.nuxt

# vuepress build output
.vuepress/dist

# Serverless directories
.serverless/

# FuseBox cache
.fusebox/

# DynamoDB Local files
.dynamodb/

# TernJS port file
.tern-port

# Stores VSCode versions used for testing VSCode extensions
.vscode-test

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Image processing outputs (temporary files and processed images)
temp-images/
processed-images/
previews/
mono-optimized/
mono-test/
quick-processed/
*.processed.png
*.resized.png
*.optimized.png

# Keep docs directory structure but ignore temporary processing files
!docs/
docs/temp/

# Keep script archives for reference
!scripts/archive/

# 字体文件 - 只保留简体中文版本
assets/fonts/fusion-pixel-*-ja.otf.woff2
assets/fonts/fusion-pixel-*-ko.otf.woff2
assets/fonts/fusion-pixel-*-latin.otf.woff2
assets/fonts/fusion-pixel-*-zh_hant.otf.woff2
assets/fonts/SmileySans-*

# Quality evaluation tool - runtime generated reports
tools/quality-evaluation/reports/*.md